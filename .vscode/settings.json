{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "git.autofetch": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "emeraldwalk.runonsave": {
    "ignoreUnchangedFiles": false,
    "autoClearConsole": false,
    "commands": [
      {
        "match": "[/\\\\]lab[0-9]+-notebook\\.ipynb$",
        "cmd": "\"${workspaceFolder}/.tools/uv/uv\" run --no-project --python \"${workspaceFolder}/.venv\" python \"${workspaceFolder}/.utilities/sync_notebooks.py\"",
        "isAsync": true,
        "autoShowOutputPanel": "error"
      }
    ]
  },
  "workbench.sideBar.location": "left",
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "claudeCode.preferredLocation": "sidebar"
}

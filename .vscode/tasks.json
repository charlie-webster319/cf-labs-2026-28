{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup lab environment",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.utilities/setup_lab.sh"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.utilities/setup_lab.ps1"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Install optional AI tools",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.utilities/install_ai.sh"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.utilities/install_ai.ps1"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Check whether your work has synced",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/.utilities/sync_notebooks.py",
        "--check"
      ],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Sync lab notebooks now",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/.utilities/sync_notebooks.py"
      ],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
